{%- comment -%}
  Estilos propios de Pili Trespalacios, encima de Horizon.
  Detalle de la marca en docs/01_marca-y-marketing/identidad-visual.md
  y de la tienda en docs/05_ventas/tienda-diseno.md.
{%- endcomment -%}
<style>
  /* Logotipo: el nombre de la tienda en Tenor Sans, mayúsculas y letras separadas */
  /* "a.header-logo" para ganarle al estilo del bloque de Horizon, que se carga después */
  a.header-logo {
    font-family: var(--font-subheading--family);
    font-weight: 400;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    padding-inline-start: 0.34em;
    font-size: 1.375rem;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    /* Como la maqueta en celular: sin lupa, y el nombre a 15 px usa también los espacios
       vacíos de la lupa y la cuenta, para quedar centrado sin tapar el carro */
    header-component search-button.search-action {
      display: none;
    }

    a.header-logo {
      font-size: 0.9375rem;
      letter-spacing: 0.24em;
      padding-inline-start: 0.24em;
      margin-inline: -44px;
    }
  }

  /* Botones: Tenor Sans en mayúsculas, sin bordes redondeados */
  .button,
  .button-secondary,
  .button-custom {
    font-family: var(--font-subheading--family);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8125rem;
  }

  /* El bronce se usa solo en detalles: el foco del teclado */
  :focus-visible {
    outline-color: #a88b6a;
  }

  /* Mientras falten fotos: recuadro color piedra en vez de los dibujos de Shopify */
  .placeholder-image {
    background-color: #d6d1c9;
  }

  .placeholder-image .image-block__placeholder {
    visibility: hidden;
  }

  /* Cursivas de los títulos (por ejemplo, "Colección Astur") */
  :is(h1, h2, h3) em {
    font-style: italic;
  }

  /* Ancho de página de la maqueta: 1280 px con 40 px de margen (20 px en celular) */
  body.page-width-narrow {
    --page-content-width: 75rem;
  }

  @media screen and (max-width: 749px) {
    body.page-width-narrow {
      --page-margin: 20px;
    }
  }

  /* Encabezado como en la maqueta: 88 px de alto, línea piedra abajo y sin ícono de cuenta */
  .header__row--top {
    min-height: 88px;
  }

  header-component.header {
    border-bottom: 1px solid #d6d1c9;
  }

  .header .account-button,
  .header account-button,
  .header [href*='/account'] {
    display: none;
  }

  /* Submenú del computador en una sola fila horizontal, para que no tape la página
     cuando haya más subcategorías (Horizon las pone una debajo de otra) */
  @media screen and (min-width: 750px) {
    header-component .mega-menu__grid,
    header-component .mega-menu__list,
    header-component .mega-menu__column {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 40px;
      row-gap: 12px;
    }

    header-component .mega-menu__list,
    header-component .mega-menu__column {
      grid-column: auto;
    }

    /* Misma letra que el menú principal (12 px); Horizon la ponía en 14 px */
    header-component .mega-menu__link {
      font-size: 12px;
    }

    header-component .menu-list__submenu-inner {
      --submenu-padding-block-start: 12px;
      --submenu-padding-block-end: 12px;
    }
  }

  /* ---- Secciones de la portada copiadas de la maqueta (sections/pt-*.liquid) ---- */
  .pt {
    font-family: var(--font-body--family);
    font-size: 18px;
    line-height: 1.6;
    color: #141414;
  }

  .pt-wrap {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 40px;
    box-sizing: border-box;
    width: 100%;
  }

  .pt .pt-antetitulo {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #6b665e;
    line-height: 1.6;
  }

  .pt .pt-titulo {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: clamp(34px, 3.6vw, 48px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .pt .pt-titulo em {
    font-style: italic;
  }

  .pt .pt-texto {
    margin: 0;
    max-width: 28em;
    color: #3a3732;
    text-wrap: pretty;
  }

  .pt .pt-boton {
    display: inline-block;
    background: #141414;
    color: #fbfaf8;
    text-decoration: none;
    font-family: var(--font-subheading--family);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 17px 30px;
    min-height: 44px;
    box-sizing: border-box;
    line-height: 1.2;
  }

  .pt .pt-boton:hover {
    background: #3a3732;
  }

  .pt .pt-enlace {
    font-family: var(--font-subheading--family);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #141414;
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .pt-encabezado {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .pt-encabezado__titulos {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pt .pt-encabezado__bajada {
    max-width: 26em;
  }

  .pt-tarjeta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #141414;
    text-decoration: none;
  }

  .pt-tarjeta__foto {
    aspect-ratio: 4 / 5;
    background: #d6d1c9;
    overflow: hidden;
  }

  .pt-tarjeta__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pt-tarjeta__datos {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pt-tarjeta__nombre {
    font-size: 20px;
    line-height: 1.3;
  }

  .pt-tarjeta__material {
    font-family: var(--font-subheading--family);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6b665e;
  }

  .pt-tarjeta__precio {
    font-size: 16px;
    color: #3a3732;
  }

  .pt a:focus-visible,
  .pt button:focus-visible {
    outline: 2px solid #a88b6a;
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .pt-wrap {
      padding-inline: 20px;
    }
  }
</style>
