    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .header-logo {
      font-size: 0.9375rem;
    }
  }

  /* Botones: Tenor Sans en mayúsculas, sin bordes redondeados */
  .button,
  .button-secondary,
  .button-custom {
    font-family: var(--font-subheading--family);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.8125rem;
  }

